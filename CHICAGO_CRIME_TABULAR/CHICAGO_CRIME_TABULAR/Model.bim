        "partitions": [
          {
            "name": "FactCrime",
            "dataView": "full",
            "source": {
              "type": "query",
              "query": " SELECT [dbo].[FactCrime].* FROM [dbo].[FactCrime] ",
              "dataSource": "SqlServer DESKTOP-IFD8LT5WAD ChicagoCrime_DW"
            }
          }
        ],
        "measures": [
          {
            "name": "Total Crimes",
            "expression": " COUNTROWS(FactCrime)"
          },
          {
            "name": "Arrest Count",
            "expression": " CALCULATE( COUNTROWS(FactCrime), FactCrime[Arrest] = TRUE() )"
          },
          {
            "name": "Arrest Rate",
            "expression": " DIVIDE( [Arrest Count], [Total Crimes] )"
          },
          {
            "name": "Domestic Count",
            "expression": " CALCULATE( COUNTROWS(FactCrime), FactCrime[Domestic] = TRUE() )"
          },
          {
            "name": "Domestic Rate",
            "expression": " DIVIDE( [Domestic Count], [Total Crimes] )"
          },
          {
            "name": "Daily Crime Avg",
            "expression": " DIVIDE( [Total Crimes], DISTINCTCOUNT(DimDate[FullDate]) )"
          },
          {
            "name": "Distinct Days",
            "expression": " DISTINCTCOUNT(DimDate[FullDate])"
          }
        ],
