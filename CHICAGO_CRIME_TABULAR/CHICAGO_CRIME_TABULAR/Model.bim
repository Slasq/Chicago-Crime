        "partitions": [
          {
            "name": "CalculatedTable 1",
            "source": {
              "type": "calculated",
              "expression": "SUMMARIZECOLUMNS(clusters_prediction[ClusterID], \"Crimes\", COUNTROWS(clusters_prediction), \"ArrestRate\", DIVIDE(CALCULATE(COUNTROWS(FactCrime), FactCrime[Arrest]=TRUE()), COUNTROWS(FactCrime)))"
