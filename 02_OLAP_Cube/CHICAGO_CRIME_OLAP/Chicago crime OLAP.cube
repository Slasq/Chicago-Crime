  <MdxScripts>
    <MdxScript dwd:design-time-name="e59594b6-8016-42d7-b74a-677ce1eb6708">
      <ID>MdxScript</ID>
      <Name>MdxScript</Name>
      <CreatedTimestamp>0001-01-01T00:00:00Z</CreatedTimestamp>
      <LastSchemaUpdate>0001-01-01T00:00:00Z</LastSchemaUpdate>
      <Commands>
        <Command>
          <Text>/*
The CALCULATE command controls the aggregation of leaf cells in the cube.
If the CALCULATE command is deleted or modified, the data within the cube is affected.
You should edit this command only if you manually specify how the cube is aggregated.
*/
CALCULATE;  
CREATE MEMBER CURRENTCUBE.[Measures].[Arrest Rate]
 AS ([Measures].[Arrest] / [Measures].[Fact Crime Count]) * 100, 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Arrest] }, 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Theft Rate]
 AS ([Measures].[Fact Crime Count], [Dim Crime Type].[Primary Type].&amp;[06]&amp;[THEFT]) 
/ [Measures].[Fact Crime Count] * 100, 
FORMAT_STRING = "0.00", 
VISIBLE = 1  ;  
CREATE MEMBER CURRENTCUBE.[Measures].[Daily Crime Average]
 AS [Measures].[Fact Crime Count] / 365, 
FORMAT_STRING = "0.00", 
VISIBLE = 1;  
CREATE MEMBER CURRENTCUBE.[Measures].[Domestic Rate]
 AS ([Measures].[Domestic] / [Measures].[Fact Crime Count]) * 100, 
FORMAT_STRING = "Percent", 
NON_EMPTY_BEHAVIOR = { [Domestic] }, 
VISIBLE = 1; </Text>
        </Command>
      </Commands>
    </MdxScript>
  </MdxScripts>
  <Kpis>
    <Kpi dwd:design-time-name="d372b934-c61c-42fb-b933-fca1159f73e6">
      <ID>KPI</ID>
      <Name>Arrest Effectiveness</Name>
      <AssociatedMeasureGroupID>Fact Crime</AssociatedMeasureGroupID>
      <Value>[Measures].[Arrest Rate]</Value>
      <Goal>15</Goal>
      <Status>CASE
  WHEN KpiValue("Arrest Effectiveness") &gt;= KpiGoal("Arrest Effectiveness") THEN 1
  WHEN KpiValue("Arrest Effectiveness") &gt;= KpiGoal("Arrest Effectiveness") * 0.7 THEN 0
  ELSE -1
END</Status>
      <Trend>0</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Gauge - Ascending</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="66e0f58b-b7bf-48ed-b375-322f58c963bd">
      <ID>KPI 1</ID>
      <Name>Domestic Violence Watch</Name>
      <AssociatedMeasureGroupID>Fact Crime</AssociatedMeasureGroupID>
      <Value>[Measures].[Domestic Rate]</Value>
      <Goal>20</Goal>
      <Status>CASE
  WHEN KpiValue("Domestic Violence Watch") &lt;= KpiGoal("Domestic Violence Watch") THEN 1
  WHEN KpiValue("Domestic Violence Watch") &lt;= KpiGoal("Domestic Violence Watch") * 1.2 THEN 0
  ELSE -1
END</Status>
      <Trend>0</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="02d9eeb6-77dd-4767-a68f-c76a51d27974">
      <ID>KPI 2</ID>
      <Name>Crime Volume Annual</Name>
      <AssociatedMeasureGroupID>Fact Crime</AssociatedMeasureGroupID>
      <Value>[Measures].[Fact Crime Count]</Value>
      <Goal>250000</Goal>
      <Status>CASE
  WHEN KpiValue("Crime Volume Annual") &lt;= KpiGoal("Crime Volume Annual") THEN 1
  WHEN KpiValue("Crime Volume Annual") &lt;= KpiGoal("Crime Volume Annual") * 1.5 THEN 0
  ELSE -1
END</Status>
      <Trend>0</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="e6c9e082-bb33-447d-91aa-f8726e3254f5">
      <ID>KPI 3</ID>
      <Name>Theft Rate</Name>
      <AssociatedMeasureGroupID>Fact Crime</AssociatedMeasureGroupID>
      <Value>[Measures].[Theft Rate]</Value>
      <Goal>25</Goal>
      <Status>CASE
  WHEN KpiValue("Theft Rate") &lt;= KpiGoal("Theft Rate") THEN 1
  WHEN KpiValue("Theft Rate") &lt;= KpiGoal("Theft Rate") * 1.2 THEN 0
  ELSE -1
END</Status>
      <Trend>0</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
    <Kpi dwd:design-time-name="91073212-66e8-49a0-9299-dccabbf05531">
      <ID>KPI 4</ID>
      <Name>Daily Crime Load</Name>
      <Value>[Measures].[Daily Crime Average]</Value>
      <Goal>700</Goal>
      <Status>CASE
  WHEN KpiValue("Daily Crime Load") &lt;= KpiGoal("Daily Crime Load") THEN 1
  WHEN KpiValue("Daily Crime Load") &lt;= KpiGoal("Daily Crime Load") * 1.3 THEN 0
  ELSE -1
END</Status>
      <Trend>0</Trend>
      <TrendGraphic>Standard Arrow</TrendGraphic>
      <StatusGraphic>Traffic Light</StatusGraphic>
    </Kpi>
  </Kpis>
